---
import { Image } from 'astro:assets';
import { site } from '../config';
import { useTranslations, localePath, type Lang } from '../i18n/utils';
import lonbali from '../assets/modeling/lonbali.jpg';
import susmies from '../assets/modeling/susmies.jpg';
import clara from '../assets/modeling/clara.jpg';

interface Props {
  lang: Lang;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { lang, image, imageAlt } = Astro.props;
const t = useTranslations(lang);
const contactHref = localePath(lang, lang === 'es' ? 'contacto' : 'contact');
const modelingPhotos = [
  {
    src: lonbali,
    brand: 'Lonbali',
    alt: lang === 'es' ? 'Campaña de modelaje para Lonbali' : 'Modelling campaign for Lonbali',
  },
  {
    src: susmies,
    brand: 'Susmies',
    alt: lang === 'es' ? 'Trabajo de modelaje para Susmies' : 'Modelling work for Susmies',
  },
  {
    src: clara,
    brand: 'Revista Clara',
    alt: lang === 'es' ? 'Portada de Revista Clara con Gisela Mateu' : 'Revista Clara cover featuring Gisela Mateu',
  },
];
---

<section class="wrap section about">
  <div class="about-head">
    <h1 class="display about-title">{t('about.title')}</h1>
  </div>
  <div class="about-grid">
    <div class="about-body">
      <p class="lede" data-reveal>{t('about.lead')}</p>
      <div class="prose" data-reveal style="--reveal-delay:100ms">
        <p>{t('about.body1')}</p>
        <p>{t('about.body2')}</p>
        <p>{t('about.body3')}</p>
      </div>
    </div>
    {
      image && (
        <div class="about-media media" data-reveal style="--reveal-delay:160ms">
          <Image src={image} alt={imageAlt ?? ''} widths={[600, 900, 1200]} sizes="(min-width: 860px) 30vw, 92vw" loading="lazy" decoding="async" />
        </div>
      )
    }
  </div>
</section>

<section class="wrap section--tight modeling-work">
  <div class="section-head">
    <h2>{t('about.modeling')}</h2>
    <span class="mono">{String(modelingPhotos.length).padStart(2, '0')}</span>
  </div>
  <div class="modeling-grid">
    {modelingPhotos.map((photo, i) => (
      <figure class="modeling-card" data-reveal style={`--reveal-delay:${i * 90}ms`}>
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[500, 800, 1200]}
          sizes="(min-width: 1000px) 28vw, (min-width: 640px) 44vw, 92vw"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="mono">{photo.brand}</figcaption>
      </figure>
    ))}
  </div>
</section>

<section class="wrap section--tight">
  <div class="section-head">
    <h2>{t('about.contact')}</h2>
  </div>
  <div class="contact" data-reveal>
    <div class="contact-row">
      <span class="mono">{t('about.emailLabel')}</span>
      <a class="contact-value" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <div class="contact-row">
      <span class="mono">{t('about.instagramLabel')}</span>
      <a class="contact-value" href={site.instagram} target="_blank" rel="me noopener">@{site.instagramHandle}</a>
    </div>
    <div class="contact-row">
      <span class="mono">{t('about.linkedinLabel')}</span>
      <a class="contact-value" href={site.linkedin} target="_blank" rel="me noopener">in/{site.linkedinHandle}</a>
    </div>
    <p class="mono availability">{t('about.availability')}</p>
    <a class="link" href={contactHref}>{t('about.write')}</a>
  </div>
</section>

<style>
  .about-head {
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .about-title {
    font-size: var(--step-3);
  }
  .about-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: 1fr;
  }
  .about-body {
    display: grid;
    gap: 1.5rem;
    justify-items: center;
    text-align: center;
  }
  .about-media {
    aspect-ratio: 1 / 1;
    max-width: 300px;
    justify-self: center;
  }
  .about-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .contact {
    display: grid;
    gap: 0.4rem;
    max-width: 40rem;
  }
  .modeling-work {
    padding-top: clamp(1rem, 3vw, 2.5rem);
  }
  .modeling-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.2rem, 3vw, 2.5rem);
    align-items: start;
  }
  .modeling-card {
    min-width: 0;
  }
  .modeling-card img {
    display: block;
    width: 100%;
    height: auto;
  }
  .modeling-card figcaption {
    margin-top: 0.7rem;
  }
  .contact-row {
    display: grid;
    gap: 0.2rem;
    padding-block: 0.8rem;
  }
  .contact-value {
    font-size: var(--step-1);
    transition: color 0.35s var(--ease);
  }
  .contact-value:hover,
  .contact-value:focus-visible {
    color: var(--accent);
  }
  .availability {
    margin-top: 1.4rem;
  }
  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }
    .about-media {
      max-width: 280px;
      justify-self: end;
    }
  }
  @media (min-width: 640px) {
    .modeling-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .modeling-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
