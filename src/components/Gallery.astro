---
import { Image, getImage } from 'astro:assets';
import { useTranslations, getLang } from '../i18n/utils';

interface Props {
  images: ImageMetadata[];
  altBase: string;
  caption?: string;
  columns?: 2 | 3 | 4;
  sizes?: string;
}
const { images, altBase, caption, columns = 3, sizes = '(min-width: 1200px) 30vw, (min-width: 720px) 45vw, 92vw' } = Astro.props;
const t = useTranslations(getLang(Astro.url));
const fulls = await Promise.all(
  images.map((src) => getImage({ src, width: 2000, format: 'webp', quality: 82 }))
);
---

<figure class="gallery-wrap">
  <div class="gallery grid-cols" data-cols={columns}>
    {
      images.map((src, i) => (
        <button
          class="tile media"
          type="button"
          data-lightbox
          data-full={fulls[i].src}
          data-alt={`${altBase} ${i + 1} ${t('gallery.counter')} ${images.length}`}
          aria-label={`${t('gallery.open')}: ${altBase} ${i + 1}`}
          data-reveal
          style={`--reveal-delay:${Math.min(i, 8) * 45}ms`}
        >
          <Image src={src} alt={`${altBase} ${i + 1}`} widths={[500, 800, 1200]} sizes={sizes} loading="lazy" decoding="async" />
        </button>
      ))
    }
  </div>
  {caption && <figcaption class="gallery-cap mono">{caption}</figcaption>}
</figure>

<style>
  .gallery {
    display: grid;
    gap: clamp(0.5rem, 1.4vw, 1.1rem);
  }
  .gallery[data-cols='2'] {
    grid-template-columns: repeat(2, 1fr);
  }
  .gallery[data-cols='3'] {
    grid-template-columns: repeat(2, 1fr);
  }
  .gallery[data-cols='4'] {
    grid-template-columns: repeat(2, 1fr);
  }
  .tile {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--carbon);
    cursor: zoom-in;
  }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery-cap {
    margin-top: 1rem;
    max-width: 60ch;
    line-height: 1.6;
  }
  @media (min-width: 760px) {
    .gallery[data-cols='3'] {
      grid-template-columns: repeat(3, 1fr);
    }
    .gallery[data-cols='4'] {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
