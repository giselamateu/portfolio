---
import { site } from '../config';
import { useTranslations, type Lang } from '../i18n/utils';

interface Post {
  permalink: string;
  thumbnail: string;
  caption: string;
}
interface Props {
  lang: Lang;
  limit?: number;
}
const { lang, limit = 6 } = Astro.props;
const t = useTranslations(lang);

type SizeMap = Record<string, { mediaUrl?: string }>;
interface RawPost {
  permalink?: string;
  link?: string;
  caption?: string;
  thumbnailUrl?: string;
  thumbnail_url?: string;
  mediaUrl?: string;
  media_url?: string;
  sizes?: SizeMap;
  children?: { sizes?: SizeMap; mediaUrl?: string }[];
}

const pickThumb = (p: RawPost): string =>
  p.sizes?.medium?.mediaUrl ??
  p.sizes?.small?.mediaUrl ??
  p.children?.[0]?.sizes?.medium?.mediaUrl ??
  p.children?.[0]?.sizes?.small?.mediaUrl ??
  p.children?.[0]?.mediaUrl ??
  p.thumbnailUrl ??
  p.thumbnail_url ??
  p.mediaUrl ??
  p.media_url ??
  '';

let posts: Post[] = [];
if (site.instagramFeedUrl) {
  try {
    const res = await fetch(site.instagramFeedUrl);
    const data = await res.json();
    const list: RawPost[] = Array.isArray(data) ? data : (data.posts ?? data.data ?? []);
    posts = list
      .slice(0, limit)
      .map((p) => ({
        permalink: p.permalink ?? p.link ?? site.instagram,
        thumbnail: pickThumb(p),
        caption: p.caption ?? '',
      }))
      .filter((p) => p.thumbnail);
  } catch {
    posts = [];
  }
}
---

<section id="instagram" class="wrap section">
  <div class="section-head">
    <h2>{t('instagram.title')}</h2>
    <a class="mono ig-handle" href={site.instagram} target="_blank" rel="me noopener">@{site.instagramHandle}</a>
  </div>
  <p class="ig-lead mono" data-reveal>{t('instagram.lead')}</p>

  {
    posts.length > 0 ? (
      <ul class="ig-grid">
        {posts.map((p, i) => (
          <li data-reveal style={`--reveal-delay:${Math.min(i, 6) * 55}ms`}>
            <a class="ig-tile media" href={p.permalink} target="_blank" rel="noopener" title={p.caption} aria-label={p.caption || `@${site.instagramHandle}`}>
              <img src={p.thumbnail} alt={p.caption || `@${site.instagramHandle}`} loading="lazy" decoding="async" />
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="ig-cta" data-reveal>
        <p>{t('instagram.empty')}</p>
        <a class="link" href={site.instagram} target="_blank" rel="me noopener">{t('instagram.follow')}</a>
      </div>
    )
  }
</section>

<style>
  .ig-handle {
    color: var(--accent);
    letter-spacing: 0.08em;
  }
  .ig-lead {
    margin-bottom: clamp(1.4rem, 3vw, 2.4rem);
    max-width: 46ch;
    line-height: 1.6;
  }
  .ig-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.5rem, 1.4vw, 1rem);
  }
  .ig-tile {
    display: block;
    aspect-ratio: 1 / 1;
  }
  .ig-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ig-cta {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 46ch;
  }
  @media (min-width: 640px) {
    .ig-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }
  }
</style>
